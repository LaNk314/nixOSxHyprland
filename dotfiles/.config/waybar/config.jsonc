{
  "layer": "top",
  "position": "top",
  "height": 30,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["pulseaudio", "cpu", "memory", "clock", "custom/power"],

  "hyprland/window": { "max-length": 60 },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "cpu": { "format": "CPU {usage}%", "interval": 5 },
  "memory": { "format": "RAM {percentage}%", "interval": 5 },
  "clock": { "format": "{:%H:%M %d.%m}", "tooltip-format": "{:%A, %d %B %Y}" },
  "custom/power": { "format": "⏻", "tooltip": false, "on-click": "pidof wlogout || wlogout -b 4" }
} 
